# Git LFS tracking for genomic sequences, alignments, and matrices
*.fasta filter=lfs diff=lfs merge=lfs -text
*.gb filter=lfs diff=lfs merge=lfs -text
*.csv filter=lfs diff=lfs merge=lfs -text
*.tsv filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text
*.npy filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text

# Exclude iframe figures and HTML assets from language stats
iframe_figures/** linguist-generated=true
iframe_figures/** linguist-documentation=true
figures/** linguist-generated=true
**/*.html linguist-detectable=false

# Exclude Jupyter Notebook structure so Python (.py) dominates language stats
**/*.ipynb linguist-detectable=false
